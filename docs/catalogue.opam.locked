opam-version: "2.0"
name: "catalogue"
version: "dev"
synopsis: "The open-opam catalogue's islands"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "enabled"}
  "cppo" {= "1.8.0"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2"}
  "melange" {= "7.0.1-55"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mlx" {= "0.12"}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_solidtype" {= "0.14.0"}
  "ppxlib" {= "0.39.0"}
  "sexplib0" {= "v0.17.0"}
  "solidtype" {= "0.14.0"}
  "solidtype-gravity-icons" {= "0.14.0"}
  "solidtype-headless" {= "0.14.0"}
  "solidtype-heroui" {= "0.14.0"}
  "solidtype-internationalized-date" {= "0.14.0"}
  "solidtype-kobalte" {= "0.14.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]