---
// A package in a list: its date and downloads written as the page writes
// them, for the island that draws its card.
import * as Card from "@islands/package_card.jsx";
import type { Package as Pkg } from "../lib/registry";

interface Props {
  pkg: Pkg;
  downloads?: number; // shown when the list ranks by them
}

const { pkg, downloads } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const day = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Card.make
  name={pkg.name}
  version={pkg.latest.version}
  synopsis={pkg.latest.synopsis ?? ""}
  href={`${base}/packages/${pkg.name}/`}
  published={pkg.latest.published ? day(pkg.latest.published) : undefined}
  downloads={downloads !== undefined ? downloads.toLocaleString("en-GB") : undefined}
/>
